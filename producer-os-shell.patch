+<!-- PRODUCER OS BROKER ONLY:JS:START · appended only after a live realty_members.role==='broker'
+     check, same pattern as Financial Hub above. Never present in markup/CSS for agents. -->
+<script>
+(function(){
+  var ITEMS = [
+    ['bdash','Broker Command'],
+    ['inventory','Agent Inventory'],
+    ['radar','Deadline Radar'],
+    ['roster','Roster Command'],
+    ['revenue','Revenue and Fees'],
+    ['file-compliance','File Compliance']
+  ];
+  // Legacy broker_module.html panels with no other nav path after this rebuild.
+  // Everything else in the old Broker group (Transaction Review, Onboarding,
+  // Announcements, Blog Posts, Training Academy, Team Production, Team Email)
+  // stays reachable via the existing My Dashboard broker quick-action buttons,
+  // which were not touched. Only these two had no fallback, so keeping them
+  // reachable here so nothing goes dark.
+  var LEGACY_ITEMS = [
+    ['broker-email','Email'],
+    ['broker-cp','Control Panel']
+  ];
+  function buildBrokerOnlyGroup(){
+    var sidebar = document.getElementById('sidebar');
+    if(!sidebar || document.getElementById('broker-only-group')) return;
+    var grp = document.createElement('div');
+    grp.className = 'sidebar-group';
+    grp.id = 'broker-only-group';
+    var html = '<div class="sidebar-group-label">Broker Only</div>';
+    ITEMS.forEach(function(it){
+      html += '<div class="sidebar-item" data-panel="' + it[0] + '"><span class="item-name">' + it[1] + '</span></div>';
+    });
+    LEGACY_ITEMS.forEach(function(it){
+      html += '<div class="sidebar-item" data-panel="' + it[0] + '"><span class="item-name">' + it[1] + '</span></div>';
+    });
+    grp.innerHTML = html;
+    var getStartedLabel = Array.from(sidebar.querySelectorAll('.sidebar-group-label')).find(function(l){ return l.textContent === 'Get Started'; });
+    var getStartedGroup = getStartedLabel ? getStartedLabel.parentNode : null;
+    if(getStartedGroup){ sidebar.insertBefore(grp, getStartedGroup); } else { sidebar.appendChild(grp); }
+    grp.querySelectorAll('.sidebar-item').forEach(function(el){
+      el.addEventListener('click', function(){ if(window.setPanel) window.setPanel(el.dataset.panel); });
+    });
+  }
+  document.addEventListener('DOMContentLoaded', async function(){
+    try {
+      if(!window.sb || !window.sb.auth) return;
+      var s = await window.sb.auth.getSession();
+      if(!s.data.session) return;
+      var me = await window.sb.from('realty_members').select('role').eq('user_id', s.data.session.user.id).maybeSingle();
+      if(!me.data || me.data.role !== 'broker') return;
+      buildBrokerOnlyGroup();
+    } catch(e) {}
+  });
+})();
+</script>
+<!-- PRODUCER OS BROKER ONLY:JS:END -->
